{
  "name": "hi-los-geht-platform",
  "version": "1.0.0",
  "description": "Hi Los Geht (HLG) Heavy Machinery Management, Booking & Operations Platform",
  "main": "server/server.ts",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "cd client && npm run build",
    "start": "cd client && npm run start",
    "db:migrate": "node database/run_migrations.js",
    "test:b1": "node database/test_batch1_overlap.js",
    "test:b2": "node database/test_batch2_rbac.js",
    "test:b3": "node server/tests/test_batch3_pool.js",
    "test:b6": "node server/tests/test_batch6_smtp.js",
    "test:b9": "node server/tests/test_batch9_ai.js",
    "test:b10": "node server/tests/test_batch10_telemetry.js",
    "server:dev": "cd server && npm run dev",
    "client:dev": "cd client && npm run dev"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  }
}
